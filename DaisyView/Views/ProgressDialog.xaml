<Window x:Class="DaisyView.Views.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loading Folder..."
        Height="150"
        Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Status Text -->
            <TextBlock Grid.Row="0"
                       Name="StatusTextBlock"
                       Text="Loading folder..."
                       FontSize="12"
                       Margin="0,0,0,15"
                       Foreground="{StaticResource ForegroundBrush}" />

            <!-- Progress Bar -->
            <ProgressBar Grid.Row="1"
                         Name="ProgressBar"
                         Height="20"
                         Margin="0,0,0,10"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Background="#2D2D30"
                         Foreground="#007ACC" />

            <!-- Progress Text -->
            <TextBlock Grid.Row="2"
                       Name="ProgressTextBlock"
                       Text="0 / 0"
                       FontSize="10"
                       Margin="0,0,0,15"
                       Foreground="#8ED0FF"
                       TextAlignment="Center" />

            <!-- Cancel Button -->
            <Button Grid.Row="3"
                    Name="CancelButton"
                    Content="Cancel"
                    Width="80"
                    Height="30"
                    HorizontalAlignment="Center"
                    Click="CancelButton_Click"
                    Background="#007ACC"
                    Foreground="White"
                    FontSize="11" />
        </Grid>
    </Border>
</Window>
