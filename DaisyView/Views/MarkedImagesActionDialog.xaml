<Window x:Class="DaisyView.Views.MarkedImagesActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marked Images"
        Width="440"
        Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#202020"
        Foreground="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,14" />

        <TextBlock Grid.Row="1"
                   Text="Choose what to do with marked images:"
                   Opacity="0.85"
                   Margin="0,0,0,14" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Leave Marked"
                    Width="100"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="LeaveMarked_Click" />
            <Button Content="Delete"
                    Width="75"
                    Margin="0,0,8,0"
                    Click="Delete_Click" />
            <Button Content="Move"
                    Width="75"
                    Margin="0,0,8,0"
                    Click="Move_Click" />
            <Button Content="Make Favorites"
                    Width="110"
                    Click="MakeFavorites_Click" />
        </StackPanel>
    </Grid>
</Window>
